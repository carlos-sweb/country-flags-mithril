{
  "name": "country-flags-mithril",
  "version": "1.1.2",
  "description": "Country flag SVGs as Mithril.js components",
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./flags/*": {
      "types": "./flags/*.d.ts",
      "import": "./flags/*.js"
    },
    "./flags/*.js": {
      "types": "./flags/*.d.ts",
      "import": "./flags/*.js"
    },
    "./flags-lynx/*": {
      "types": "./flags-lynx/*.d.ts",
      "import": "./flags-lynx/*.js"
    },
    "./flags-lynx/*.js": {
      "types": "./flags-lynx/*.d.ts",
      "import": "./flags-lynx/*.js"
    },
    "./default_attrs": {
      "types": "./default_attrs.d.ts",
      "import": "./default_attrs.js"
    }
  },
  "files": [
    "flags/",
    "flags-lynx/",
    "default_attrs.js",
    "default_attrs.d.ts",
    "lynx_svg.js",
    "lynx_svg.d.ts",
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build/build.js",
    "prebuild": "rm -rf flags flags-lynx index.js index.d.ts && mkdir -p flags flags-lynx"
  },
  "keywords": [
    "mithril",
    "mithril-lynx",
    "lynx",
    "flags",
    "country-flags",
    "svg",
    "components"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/mithril": "^2.2.9",
    "typescript": "^5"
  },
  "peerDependencies": {
    "mithril": "^2",
    "mithril-runtime": "^1.1.0"
  },
  "peerDependenciesMeta": {
    "mithril-runtime": {
      "optional": true
    }
  },
  "dependencies": {
    "flag-icons": "^7.5.0",
    "mithril": "^2.3.8"
  }
}
